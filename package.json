{
  "name": "fatigue-meter",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based fingertip PPG fatigue & stress meter (HRV analysis on-device)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "e2e:fixture": "node --experimental-strip-types tests/e2e/make-fixture.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0"
  }
}
